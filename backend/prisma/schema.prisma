generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id                        String         @id @default(cuid())
  email                     String         @unique
  name                      String
  avatar                    String?
  height                    Float?
  weight                    Float?
  age                       Int?
  gender                    String
  fitnessGoals              String[]
  activityLevel             String
  dietaryPreferences        String[]
  emailNotifications        Boolean        @default(true)
  telegramEnabled           Boolean        @default(false)
  telegramChatId            String?
  isAdmin                   Boolean        @default(false)
  active                    Boolean        @default(true)
  password                  String
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  parqCompleted             Boolean        @default(false)
  type                      String         @default("registered")
  notificationPreferences   Json?
  subscriptionStatus        String         @default("inactive")
  tier                      String         @default("free")
  twoFactorEnabled          Boolean        @default(false)
  twoFactorSecret           String?
  parqAnswers               Json?
  healthConditions          String?
  injuryHistory             String?
  legalAcknowledgment       Boolean        @default(false)
  preferredWorkoutDuration  Int?
  freeWorkoutTrialStartDate DateTime?
  freeWorkoutTrialUsed      Boolean        @default(false)
  trialEndDate              DateTime?
  equipmentAvailability     String[]
  
  // Stripe integration fields
  stripeCustomerId          String?
  stripeSubscriptionId      String?
  subscriptionTier          String         @default("free")
  subscriptionStartDate     DateTime?
  subscriptionEndDate       DateTime?
  hasPaymentMethod          Boolean        @default(false)
  mealPlans                 MealPlan[]
  nutritionLogs             NutritionLog[]
  parqResponses             ParqResponse[]
  subscriptions             Subscription[]
  payments                  Payment[]
  workoutLogs               WorkoutLog[]
  workoutPlans              WorkoutPlan[]
  recipes                   Recipe[]
  
  // New relations for admin system
  workoutTemplatesCreated   WorkoutTemplate[] @relation("WorkoutTemplateCreator")
  reportsCreated            UserReport[] @relation("UserReportsCreated")
  reportsReviewed           UserReport[] @relation("UserReportsReviewed")

  @@map("user_profiles")
}

model WorkoutLog {
  id             String      @id @default(uuid())
  userId         String
  planId         String
  workoutId      String
  date           DateTime    @default(now())
  exercises      Json
  notes          String?
  completed      Boolean     @default(false)
  duration       Int?        // workout duration in minutes
  rating         Int?        // 1-5 star rating
  completionRate Float?      // percentage of exercises completed
  user           UserProfile @relation(fields: [userId], references: [id])
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  price         Float
  subscriptions Subscription[] @relation("PlanSubscriptions")
}

model Payment {
  id                     String      @id @default(cuid())
  userId                 String
  subscriptionId         String?
  amount                 Float
  currency               String      @default("usd")
  status                 String
  stripePaymentIntentId  String?
  createdAt              DateTime    @default(now())
  user                   UserProfile @relation(fields: [userId], references: [id])
  subscription           Subscription? @relation(fields: [subscriptionId], references: [id])
}

model Subscription {
  id        String      @id @default(cuid())
  userId    String
  plan      String
  status    String
  startDate DateTime
  endDate   DateTime?
  planId    String
  payments  Payment[]
  planRef   Plan        @relation("PlanSubscriptions", fields: [planId], references: [id])
  user      UserProfile @relation(fields: [userId], references: [id])
}

model NutritionLog {
  id       String      @id @default(cuid())
  userId   String
  date     DateTime    @default(now())
  foods    Json
  calories Float
  notes    String?
  user     UserProfile @relation(fields: [userId], references: [id])
}

model ContentItem {
  id        String   @id @default(cuid())
  title     String
  type      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParqResponse {
  id               String      @id @default(uuid())
  userId           String
  answers          Json
  flagged          Boolean     @default(false)
  flaggedQuestions String[]
  notes            String[]
  reviewed         Boolean     @default(false)
  reviewedBy       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             UserProfile @relation(fields: [userId], references: [id])
}

model WorkoutPlan {
  id                    String      @id @default(cuid())
  userId                String
  name                  String
  description           String
  duration              Int         // duration in weeks
  weeks                 Json        // structured workout weeks with exercises
  targetMuscleGroups    String[]
  difficulty            String
  isDefault             Boolean     @default(false)
  completed             Boolean     @default(false)
  estimatedDuration     Int?        // estimated workout duration in minutes
  equipment             String[]    // required equipment
  source                String?     // generation source: 'wger', 'openai', 'exercisedb', 'manual'
  completedWorkouts     Json?       // tracks individual workout completion: {workoutId: {completed: boolean, completedAt: DateTime, rating?: number}}
  lastWorkoutCompleted  DateTime?   // timestamp of most recent workout completion
  progressData          Json?       // detailed progress tracking: {totalWorkouts: number, completedCount: number, weeklyProgress: {}, streaks: {}}
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  user                  UserProfile @relation(fields: [userId], references: [id])
}

model MealPlan {
  id           Int         @id @default(autoincrement())
  userId       String
  dietType     String
  meals        Json
  shoppingList Json
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         UserProfile @relation(fields: [userId], references: [id])
}

model Recipe {
  id           Int         @id @default(autoincrement())
  userId       String
  name         String
  description  String?
  category     String      // breakfast, lunch, dinner, snack, dessert, side-dish
  difficulty   String      // easy, medium, hard
  prepTime     Int         // minutes
  cookTime     Int         @default(0) // minutes
  servings     Int         @default(4)
  ingredients  Json        // array of ingredient objects
  instructions Json        // array of instruction strings
  nutrition    Json?       // nutrition information object
  imageUrl     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         UserProfile @relation(fields: [userId], references: [id])
}

model Exercise {
  id              String   @id @default(cuid())
  name            String
  description     String
  category        String   // push, pull, legs, core, cardio, fullbody
  muscleGroups    String[] // array of muscle groups
  equipment       String[] // array of equipment needed
  difficulty      String   // beginner, intermediate, advanced
  instructions    String[] // step-by-step instructions
  tips            String[] @default([]) // optional tips
  imageUrl        String?  // optional image
  videoUrl        String?  // optional video
  isCustom        Boolean  @default(true) // distinguish custom vs default exercises
  createdBy       String?  // admin user ID who created it
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isActive        Boolean  @default(true) // soft delete functionality
  
  // GIF Approval System Fields
  approvalStatus    String   @default("pending") // pending, approved, flagged, hidden
  lastReviewedAt    DateTime?
  reviewedBy        String?  // Admin user ID
  flaggedReason     String?
  hideGif           Boolean  @default(false) // Emergency hide toggle
  gifPath           String?  // Associated GIF path

  @@map("exercises")
}

model ErrorReport {
  id          Int      @id @default(autoincrement())
  message     String
  stack       String?
  userAgent   String?
  url         String?
  timestamp   DateTime @default(now())
  severity    String   @default("medium") // low, medium, high, critical
  ipAddress   String?
  resolved    Boolean  @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSettings {
  id                String   @id @default(cuid())
  maintenanceMode   Boolean  @default(false)
  allowRegistrations Boolean @default(true)
  requireEmailVerification Boolean @default(false)
  notificationEmail String?
  appName           String   @default("FitArchitect")  
  appDescription    String   @default("Your AI-powered fitness companion")
  supportEmail      String   @default("support@fitarchitect.com")
  maxFreeUsers      Int      @default(1000)
  sessionTimeout    Int      @default(1440) // 24 hours in minutes
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  adminUserId  String
  adminEmail   String
  action       String   // "create", "update", "delete", "activate", "deactivate", etc.
  resourceType String   // "user", "subscription", "content", "exercise", etc.
  resourceId   String?
  resourceName String?  // Human readable name/identifier
  details      Json?    // Additional action details
  ipAddress    String?
  userAgent    String?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())
}

model NotificationQueue {
  id           String    @id @default(cuid())
  type         String    // "email", "telegram", "push", etc.
  recipient    String    // email address, telegram chat id, etc.
  subject      String?
  body         String
  templateId   String?   // Reference to notification template
  scheduledFor DateTime?
  sentAt       DateTime?
  status       String    @default("pending") // "pending", "sent", "failed", "cancelled"
  attempts     Int       @default(0)
  lastAttempt  DateTime?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemNotification {
  id          String   @id @default(cuid())
  title       String
  message     String
  type        String   // "system", "user", "error", "warning", "info"
  severity    String   // "low", "medium", "high", "critical"
  targetUsers String[] // Array of user IDs, or ["all"] for all users
  readBy      String[] @default([]) // Array of user IDs who have read this notification
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  createdBy   String?  // Admin user ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ErrorLog {
  id            String   @id @default(cuid())
  message       String
  stack         String?
  errorType     String
  severity      String   @default("medium") // "low", "medium", "high", "critical"
  userId        String?  // User who encountered the error (if applicable)
  endpoint      String?  // API endpoint where error occurred
  method        String?  // HTTP method
  statusCode    Int?
  userAgent     String?
  ipAddress     String?
  requestBody   Json?    // Sanitized request body (no sensitive data)
  resolved      Boolean  @default(false)
  resolvedBy    String?  // Admin user ID
  resolvedAt    DateTime?
  resolvedNotes String?
  count         Int      @default(1) // Number of times this same error occurred
  lastOccurrence DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WorkoutTemplate {
  id                  String   @id @default(cuid())
  name                String
  description         String
  category            String   // "strength", "cardio", "flexibility", etc.
  difficulty          String   // "beginner", "intermediate", "advanced"
  duration            Int      // Duration in weeks
  estimatedTimePerDay Int?     // Minutes per workout session
  targetMuscleGroups  String[]
  equipment           String[]
  weeks               Json     // Structured workout weeks with exercises
  tags                String[] @default([])
  isPublic            Boolean  @default(false) // Public templates available to all users
  isOfficial          Boolean  @default(false) // Official templates created by admins
  createdBy           String   // Admin user ID
  usageCount          Int      @default(0) // How many users have used this template
  rating              Float?   // Average user rating
  ratingCount         Int      @default(0)
  externalId          String?  @unique // For tracking imported templates from external sources like WGER
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  // Relation to user who created it
  creator             UserProfile @relation("WorkoutTemplateCreator", fields: [createdBy], references: [id])
  
  @@map("workout_templates")
}

model UserReport {
  id           String   @id @default(cuid())
  reportedBy   String   // User ID who made the report
  resourceType String   // "user", "workout", "exercise", "comment", etc.
  resourceId   String   // ID of the reported resource
  reason       String   // Reason for report
  description  String?  // Additional details
  status       String   @default("pending") // "pending", "reviewed", "resolved", "dismissed"
  reviewedBy   String?  // Admin user ID
  reviewedAt   DateTime?
  reviewNotes  String?  // Admin notes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  reporter     UserProfile @relation("UserReportsCreated", fields: [reportedBy], references: [id])
  reviewer     UserProfile? @relation("UserReportsReviewed", fields: [reviewedBy], references: [id])
}
