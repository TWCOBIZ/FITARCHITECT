{
  "name": "fitarchitect",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "dev:all": "npm run dev:clean && npm run db:ensure && concurrently --kill-others-on-fail \"npm run dev:backend:wait\" \"npm run dev\"",
    "dev:clean": "./scripts/cleanup-dev.sh",
    "dev:backend:wait": "sleep 2 && cd backend && npm run dev",
    "cleanup": "./scripts/cleanup-dev.sh",
    "db:setup": "./scripts/setup-db.sh",
    "db:ensure": "./scripts/ensure-db.sh",
    "db:seed": "node scripts/seed-database.js",
    "dev:mobile": "concurrently \"npm run dev\" \"cd backend && npm run dev\"",
    "dev:https": "HTTPS=true vite",
    "build": "vite build && sh scripts/setup-runtime-config.sh",
    "build:with-types": "tsc --noEmit && vite build",
    "build:production": "NODE_ENV=production npm run build",
    "build:backend": "cd backend && npm run build",
    "start": "serve -s dist -l $PORT",
    "start:production": "serve -s dist -l $PORT",
    "lint": "eslint src backend/src --max-warnings 0",
    "preview": "vite preview",
    "taskmaster": "npx -y --package=task-master-ai task-master-ai",
    "test:e2e": "cypress run",
    "test:playwright": "playwright test",
    "test:backend": "jest"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.3",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.8.0",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^7.3.0",
    "@tanstack/react-query": "^5.75.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.2",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "framer-motion": "^10.16.4",
    "gsap": "^3.13.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "next": "^15.3.2",
    "next-connect": "^1.0.0",
    "node-fetch": "^2.7.0",
    "node-telegram-bot-api": "^0.63.0",
    "openai": "^4.98.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.56.3",
    "react-hot-toast": "^2.5.2",
    "react-hotkeys-hook": "^5.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.20.0",
    "react-spring": "^10.0.1",
    "react-swipeable": "^7.0.2",
    "react-use": "^17.6.0",
    "react-use-gesture": "^9.1.3",
    "recharts": "^2.7.2",
    "serve": "^14.2.4",
    "tailwind-merge": "^3.2.0",
    "use-sound": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/next-auth": "^3.13.0",
    "@types/node": "^22.15.18",
    "@types/node-telegram-bot-api": "^0.64.8",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.1.2",
    "cypress": "^14.3.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.31",
    "prisma": "^6.8.0",
    "supertest": "^7.1.1",
    "tailwindcss": "^3.3.5",
    "ts-jest": "^29.3.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5"
  }
}
