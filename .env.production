# Production Environment Variables for Railway Deployment
# These values should be set in Railway dashboard

# API Configuration
VITE_API_URL=https://fitarchitect-production.up.railway.app
RAILWAY_ENVIRONMENT=production

# Stripe Configuration
# IMPORTANT: Get the correct publishable key from https://dashboard.stripe.com/apikeys
# It should start with pk_live_ not rk_live_
VITE_STRIPE_PUBLISHABLE_KEY=UPDATE_WITH_CORRECT_PK_LIVE_KEY

# Other required environment variables (set these in Railway)
# DATABASE_URL=postgresql://...
# JWT_SECRET=...
# OPENAI_API_KEY=...
# STRIPE_SECRET_KEY=sk_live_...